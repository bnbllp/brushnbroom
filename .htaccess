RewriteEngine On

# HTTPS + drop www. GitHub Pages ignores this file; keep it only if the site ever moves to Apache.
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]

# Do NOT strip .html. Canonical URLs on this site keep the .html extension.

Options -Indexes

<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|webp)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

<FilesMatch "\.html$">
  Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>
